Options -MultiViews
RewriteEngine On
RewriteBase /crm/

# Baseline browser protections for every CRM response. Keep the policy
# compatible with the existing dashboards and third-party integrations.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Do not expose local environment credentials.
<Files ".env">
    Require all denied
</Files>

# Do not expose runtime storage, queue, or log files.
RewriteRule ^storage(?:/|$) - [F,L,NC]
RewriteRule ^storage/.*\.(?:log|json)$ - [F,L,NC]

# Build dependencies, tests, and maintenance sources are never web content.
RewriteRule ^(?:node_modules|tests|tools|docs)(?:/|$) - [F,L,NC]

# Clean landing page URLs: /l/veneers-draper-premium-trust-v1
RewriteRule ^l/([a-z0-9\-]+)/?$ landing.php?slug=$1 [L,QSA]

# Smile Design Engine routes.
RewriteRule ^smile-design/cases/([0-9]+)/present/?$ smile-design/cases/present.php?id=$1 [L,QSA]
RewriteRule ^smile-design/cases/([0-9]+)/?$ smile-design/cases/show.php?id=$1 [L,QSA]
RewriteRule ^smile-design/consult/([0-9]+)/?$ smile-design/consult/index.php?id=$1 [L,QSA]
RewriteRule ^smile-design/intake/([A-Za-z0-9_-]+)/?$ smile-design/intake.php?token=$1 [L,QSA]
RewriteRule ^smile-design/preview/([A-Za-z0-9_-]+)/?$ smile-design/preview.php?token=$1 [L,QSA]
RewriteRule ^smile-design/real-results/([0-9]+)/present/?$ smile-design/real-results/show.php?id=$1&present=1 [L,QSA]
RewriteRule ^smile-design/real-results/([0-9]+)/?$ smile-design/real-results/show.php?id=$1 [L,QSA]

# Mobile AI portal routes.
RewriteRule ^mobile-ai/manifest\.webmanifest$ public/mobile-ai/manifest.webmanifest [L,QSA,NC]
RewriteRule ^mobile-ai/sw\.js$ public/mobile-ai/sw.js [L,QSA,NC]
RewriteRule ^mobile-ai/setup/([A-Za-z0-9_-]+)/?$ mobile-ai-setup.php?token=$1 [L,QSA,NC]
RewriteRule ^mobile-ai$ mobile-ai/ [R=302,L,QSA,NC]

# Patient Experience kiosk routes.
RewriteRule ^patient-experience/kiosk/?$ patient-experience/kiosk.php [L,QSA,NC]
RewriteRule ^patient-experience/manifest\.webmanifest$ patient-experience/manifest.webmanifest [L,QSA,NC]
RewriteRule ^patient-experience/sw\.js$ patient-experience/sw.js [L,QSA,NC]
RewriteRule ^patient-experience/setup/([A-Za-z0-9_-]+)/?$ patient-experience/setup/index.php?token=$1 [L,QSA,NC]

# Dental model builder routes.
RewriteRule ^dental-models/?$ dental-models/index.php [L,QSA]
RewriteRule ^dental-models/new/?$ dental-models/new.php [L,QSA]
RewriteRule ^dental-models/([0-9]+)/builder/?$ dental-models/builder.php?id=$1 [L,QSA]
RewriteRule ^dental-models/([0-9]+)/download-original/?$ app/actions/dental_model_file.php?id=$1&download=1 [L,QSA]
