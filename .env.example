# Elite Smiles CRM — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

APP_KEY=replace_with_64_char_hex_from_php_random_bytes_32

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nbkuymev_elitesmilesmktg
DB_USER=nbkuymev_esmadmin
DB_PASS=your_db_password_here

OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o
ELITE_AI_AUTOREPLY_ENABLED=false
ELITE_AI_NEW_LEAD_AUTOTEXT_ENABLED=false
ELITE_AI_MIN_CONFIDENCE=0.82
ELITE_LEAD_AGENT_ENABLED=true
# active sends approved messages; shadow records decisions without sending; off disables the agent.
ELITE_LEAD_AGENT_MODE=active
ELITE_LEAD_AGENT_CRON_SECRET=

ELITE_PUSHOVER_APP_TOKEN=your_pushover_app_token
ELITE_PUSHOVER_USER_KEY=your_pushover_user_key
ELITE_PUSHOVER_USER_KEY_HEATHER=your_heather_pushover_user_key
ELITE_PUSHOVER_USER_KEY_BLAIR=your_blair_pushover_user_key
